{
  "name": "nat-pw-ai-poc",
  "version": "0.1.1",
  "description": "Universal NetReveal (NR) test template: Playwright Test + TypeScript (UI + SSH)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:ssh": "playwright test --project=ssh",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "config:print": "tsx scripts/printConfig.ts",
    "nat": "tsx dashboard/server.ts",
    "test:ssh:batch": "tsx scripts/testSshBatchStatus.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "ssh",
    "netreveal",
    "test-framework"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.0",
    "properties-reader": "^2.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.13.10",
    "@types/properties-reader": "^2.1.3",
    "@types/ssh2": "^1.15.6",
    "playwright": "^1.61.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
