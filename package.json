{
  "name": "nat-pw-ai-poc",
  "version": "0.1.0",
  "description": "NetReveal test framework: Playwright Test + AI Agents (UI), Cucumber SSH (non-UI)",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "npm run test:ui && npm run test:ssh",
    "test:e2e": "cucumber-js --config cucumber.js --tags \"not @ui and not @legacy-ui\"",
    "test:ui": "playwright test",
    "test:ssh": "cucumber-js --config cucumber.js --tags \"@SSH\"",
    "test:legacy-ui": "cucumber-js --config cucumber.js --tags \"@legacy-ui\"",
    "lint": "echo \"Linting is not configured yet.\"",
    "config:print": "node scripts/printConfig.js",
    "test:ssh:batch": "node scripts/testSshBatchStatus.js"
  },
  "keywords": [
    "cucumber",
    "bdd",
    "test-framework",
    "commonjs",
    "playwright"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "dotenv": "^16.4.0",
    "properties-reader": "^2.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.13.10",
    "playwright": "^1.61.1",
    "typescript": "^5.8.2"
  }
}
