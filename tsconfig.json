{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/ui/**/*.ts",
    "src/capabilities/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/capabilities/sshClient.js"
  ]
}
