# SNB environments are selected by alias, not by a single env file:
#   config/environments/<alias>.env   (gitignored; template: config/environments/example.env)
#   npm run nr -- <alias> <npm-script>
# Aliases used on SNB v9: dev1, dev2, qa1, qa2, qa4, inst1, proddev, prodqa, perf, perf2.
# Values come from Confluence "Environments Details V9"; placeholders only in tracked files.
