# UNIQA QA overlay — copy to repo root as `.env` (gitignored).
#   cp projects/uniqa/env.example .env
#   cp config/projects/uniqa.example.properties config/local.properties
# Never commit the real `.env`.

APPLICATION_ENVIRONMENT=uniqa-qa
ProjectName=UNIQA

# --- UI (NetReveal 9.6 EIM) ---
ui.baseUrl=https://nr-qa-uniqa.symphonyai.dev/netreveal/login.do
userDataAdminUsername=admin
USER_DATA_ADMIN_PASSWORD=
USER_DATA_DEFAULT_PASSWORD=

# --- Kafka UI (optional / future) ---
KAFKA_UI_URL=https://nr-kafka-ui-test-uniqa.symphonyai.cloud/auth
KAFKA_UI_USER=netreveal
KAFKA_UI_PASSWORD=

# --- REST / OAuth (optional / future) ---
OAUTH_TOKEN_URL=https://nr-test-uniqa.symphonyai.cloud/netreveal/rest-external/oauth/token
OAUTH_CLIENT_ID=uniqa_qa
OAUTH_CLIENT_SECRET=
CDD_ENDPOINT_URL=https://nr-test-uniqa.symphonyai.cloud/netreveal/rest-external/eim-services/v1.0.0/servicesmanager/processMessage

# --- MinIO (optional / future) ---
MINIO_HOST=nr-minio-qa-uniqa.symphonyai.dev
MINIO_PORT=443
MINIO_USER=minio
MINIO_PASSWORD=

# --- DB admin (optional / future) ---
DB_ADMIN_URL=https://nr-adminerevo-qa-uniqa.symphonyai.dev/
DB_NAME=netreveal
DB_USER=apps
DB_PASSWORD=

# --- SSH / batch (optional) ---
# ssh.host=
# ssh.user=
SSH_KEYFILE=
BATCH_SERVICE_NAME=
