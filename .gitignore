reports/
reports/allure-results/
reports/screenshots/
.json reports/*.json

# Playwright Test
.auth/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment & local / project overlays (secrets) — never commit real credentials
.env
.env.*
!.env.example
config/local.properties
config/projects/*.properties
!config/projects/example.properties
