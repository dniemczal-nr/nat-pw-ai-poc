# Copy to `.env` (gitignored) for local / project runs.
# Core template on main must NOT contain real customer secrets.
# Prefer a project branch or private fork for customer overlays (see README).

# --- Project identity ---
APPLICATION_ENVIRONMENT=qa1
# ProjectName=ACME

# --- UI (NetReveal login) ---
# Full URL overrides the template host pattern:
# ui.baseUrl=https://ui-lb.qa1.example.nr.local:8080/netreveal/login.do
userDataAdminUsername=admin
USER_DATA_ADMIN_PASSWORD=
USER_DATA_DEFAULT_PASSWORD=
USER_DATA_PASSWORD1=
AUTH_PASSWORD=

# --- SSH / batch ---
# ssh.host=batch.qa1.example.nr.local
# ssh.user=ec2-user
SSH_KEYFILE=
BATCH_SERVICE_NAME=

# --- Optional integrations (stubs — wire when capabilities exist) ---
# Kafka UI
# KAFKA_UI_URL=
# KAFKA_UI_USER=
# KAFKA_UI_PASSWORD=

# REST / OAuth
# OAUTH_TOKEN_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# CDD_ENDPOINT_URL=

# MinIO
# MINIO_HOST=
# MINIO_PORT=443
# MINIO_USER=
# MINIO_PASSWORD=

# DB admin / JDBC (future)
# DB_ADMIN_URL=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
